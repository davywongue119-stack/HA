var currentLang = 'fr';

function t(key){
  return (I18N[currentLang] && I18N[currentLang][key]) || (I18N.fr[key]) || key;
}

function applyTranslations(){
  document.querySelectorAll('[data-i18n]').forEach(function(el){
    var v = t(el.getAttribute('data-i18n'));
    if(v) el.textContent = v;
  });
  document.querySelectorAll('[data-i18n-html]').forEach(function(el){
    var v = t(el.getAttribute('data-i18n-html'));
    if(v) el.innerHTML = v;
  });
  document.documentElement.lang = currentLang;
  document.querySelectorAll('.lang-btn .lg').forEach(function(s){
    s.classList.toggle('active', s.getAttribute('data-lang') === currentLang);
  });
  if(typeof renderCerts === 'function') renderCerts();
}

function setLang(lang){
  if(lang !== 'fr' && lang !== 'en') return;
  currentLang = lang;
  try{ localStorage.setItem('wd_lang', lang); }catch(e){}
  applyTranslations();
}

document.getElementById('langBtn').addEventListener('click', function(){
  setLang(currentLang === 'fr' ? 'en' : 'fr');
});

(function(){
  try{
    var saved = localStorage.getItem('wd_lang');
    if(saved === 'en' || saved === 'fr') currentLang = saved;
  }catch(e){}
  if(currentLang !== 'fr') applyTranslations();
})();

/* NAVIGATION */
(function(){
  var head = document.getElementById('siteHead');
  function headerHeight(){ return head ? head.getBoundingClientRect().height : 64; }
  function scrollToId(id){
    var el = document.getElementById(id);
    if(!el) return;
    var top = el.getBoundingClientRect().top + window.pageYOffset - headerHeight() - 18;
    if(top < 0) top = 0;
    window.scrollTo({top: top, behavior: 'smooth'});
  }
  document.querySelectorAll('a[data-target]').forEach(function(a){
    a.addEventListener('click', function(e){
      var id = a.getAttribute('data-target');
      if(!document.getElementById(id)) return;
      e.preventDefault();
      scrollToId(id);
      if(history.replaceState){ history.replaceState(null, '', '#' + id); }
    });
  });
  window.addEventListener('load', function(){
    if(window.location.hash){
      var id = window.location.hash.substring(1);
      if(document.getElementById(id)){ setTimeout(function(){ scrollToId(id); }, 80); }
    }
  });
})();

(function(){
  var links = document.querySelectorAll('.head-nav a[data-target]');
  var sections = [];
  links.forEach(function(a){
    var s = document.getElementById(a.getAttribute('data-target'));
    if(s) sections.push({el: s, link: a});
  });
  function update(){
    var y = window.scrollY + 140;
    var cur = null;
    sections.forEach(function(s){ if(s.el.offsetTop <= y) cur = s; });
    links.forEach(function(a){ a.classList.remove('active'); });
    if(cur) cur.link.classList.add('active');
  }
  window.addEventListener('scroll', update, {passive: true});
  window.addEventListener('resize', update);
  update();
})();

/* REVEAL */
var io = new IntersectionObserver(function(es){
  es.forEach(function(e){ if(e.isIntersecting) e.target.classList.add('on'); });
}, {threshold: .12, rootMargin: '0px 0px -40px 0px'});
document.querySelectorAll('.rv').forEach(function(el){ io.observe(el); });

/* CERTIFICATS */
var renderCerts;

(function(){
  var DOCUMENTS = [
    {key:'doc.diplome',   type:'image/jpeg', data:'diplome-ingenieur-wongue-davy-cedric.jpg', revealable:true},
    {key:'doc.penn',      type:'image/jpeg', data:'certificat-penn-finance.jpg',              revealable:true},
    {key:'doc.c1english', type:'image/jpeg', data:'certificat-c1-anglais.jpg',                revealable:true},
    {key:'doc.bloomberg', type:'image/jpeg', data:'certificat-bloomberg-bmc.jpg',             revealable:false}
  ];
  var grid = document.getElementById('certGrid');
  var empty = document.getElementById('certEmpty');
  var lb = document.getElementById('lightbox');
  var lbContent = document.getElementById('lbContent');
  var lbCap = document.getElementById('lbCap');
  var lbClose = document.getElementById('lbClose');

  function esc(s){
    return String(s).replace(/[&<>"']/g, function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }
  function soonBox(){
    return '<div class="soon">' +
      '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>' +
      '<b>' + t('soon.title') + '</b>' +
    '</div>';
  }
  function loadOverlay(){
    return '<div class="load-overlay">' +
      '<div class="spinner"></div>' +
      '<div class="load-label">' + t('preview.loading') + '</div>' +
    '</div>';
  }

  renderCerts = function(){
    Array.prototype.slice.call(grid.children).forEach(function(c){
      if(c !== empty) grid.removeChild(c);
    });
    if(DOCUMENTS.length === 0){ empty.style.display = ''; empty.textContent = t('certs.loading'); return; }
    empty.style.display = 'none';

    DOCUMENTS.forEach(function(c, idx){
      var name = t(c.key);
      var card = document.createElement('div');
      card.className = 'cert-card';
      card.addEventListener('click', function(){ openLightbox(idx); });

      var thumb = document.createElement('div');
      thumb.className = c.revealable ? 'cert-thumb preview-visible' : 'cert-thumb';

      if(c.type.indexOf('pdf') === 0){
        thumb.innerHTML = soonBox();
      } else {
        var img = document.createElement('img');
        img.src = c.data; img.alt = name; img.loading = 'lazy';
        img.onerror = function(){ thumb.innerHTML = soonBox(); };
        thumb.appendChild(img);
        if(!c.revealable){
          thumb.insertAdjacentHTML('beforeend', loadOverlay());
        }
      }

      var info = document.createElement('div');
      info.className = 'cert-info';
      info.innerHTML = '<div class="t">' + esc(name) + '</div>';

      card.appendChild(thumb); card.appendChild(info);
      grid.appendChild(card);
    });
  };

  function openLightbox(idx){
    var c = DOCUMENTS[idx];
    var name = t(c.key);
    lbContent.innerHTML = '';

    if(c.type.indexOf('pdf') === 0){
      var iframe = document.createElement('iframe');
      iframe.src = c.data;
      iframe.style.cssText = 'width:min(900px,92vw);height:82vh;background:#fff;border:0';
      lbContent.appendChild(iframe);
    } else {
      var wrap = document.createElement('div');
      wrap.className = c.revealable ? 'img-wrap revealable' : 'img-wrap';
      var img = document.createElement('img');
      img.src = c.data; img.alt = name;
      img.onerror = function(){
        lbContent.innerHTML = '<div class="soonbox"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><b>' + t('soon.long') + '</b></div>';
      };
      wrap.appendChild(img);
      wrap.insertAdjacentHTML('beforeend', loadOverlay());
      if(c.revealable){
        wrap.addEventListener('click', function(){ wrap.classList.add('revealed'); });
      }
      lbContent.appendChild(wrap);
    }
    lbCap.textContent = name;
    lb.classList.add('open');
  }

  function closeLightbox(){ lb.classList.remove('open'); lbContent.innerHTML = ''; }
  lbClose.addEventListener('click', closeLightbox);
  lb.addEventListener('click', function(e){ if(e.target === lb) closeLightbox(); });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeLightbox(); });

  renderCerts();
})();
</script>
